{
  "name": "darzmarket-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "preview": "vite preview",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:build": "VITE_API_BASE_URL=http://127.0.0.1:8787/api VITE_FEATURE_SET=full VITE_E2E_BOOM=1 vite build --outDir dist-e2e --logLevel error"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
