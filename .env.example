# Copy to `.env.local` and adjust for your environment.
# Every var the app reads is listed here — the code has no hardcoded fallbacks.

# Base URL of darzmarket-api, including the `/api` prefix.
# Local backend (docker compose + runserver): http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket origin for the auction live-lot socket (Phase 8). NO `/api` suffix,
# NO trailing slash. Django (daphne) serves HTTP + WS from the same port, so
# this is usually the API host with the ws:// scheme.
# Local: ws://localhost:8000
VITE_API_WS_URL=ws://localhost:8000
