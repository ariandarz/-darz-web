# Production build config. Vite reads this during `vite build`.
#
# PLACEHOLDER — NOT A REAL BACKEND.
#
# `darzmarket-api` has no deployed URL yet (Phase 14 "Environment config
# (API base URL per environment)" is still open, and its cutover is meant to
# be coordinated with the API's own Phase 18). This value exists only so the
# deployed build can boot: `resolveBaseUrl()` in src/api/index.ts throws when
# VITE_API_BASE_URL is unset, and `api` is built at module load, so an unset
# value is a blank page rather than a degraded one.
#
# `.invalid` is reserved by RFC 2606 and can never resolve, so every API call
# fails immediately and visibly instead of reaching some unintended host.
# The deployed build is therefore a VISUAL REVIEW BUILD: layout, chrome,
# routing and both themes are real; login and all data are not.
#
# To make the deploy functional: replace this with the real base URL
# (including the `/api` prefix) and redeploy. Nothing else needs to change.
VITE_API_BASE_URL=https://api.invalid/api

# Same placeholder rationale for the auction WebSocket origin (Phase 8):
# `.invalid` can never resolve, so the socket fails fast and visibly instead
# of reaching an unintended host. Replace with `wss://<real-api-host>` for a
# functional deploy.
VITE_API_WS_URL=wss://ws.invalid

# The launch scope (see .env.example). v0.1 is also the default when unset.
VITE_FEATURE_SET=v0.1
